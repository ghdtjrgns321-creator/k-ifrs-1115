# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# ── Claude Code ────────────────────────────────────────────────────
CLAUDE.md

# ── 환경변수 / 시크릿 ────────────────────────────────────────────
.env

# ── 데이터 (원본은 MongoDB 적재 완료, git 제외) ──────────────────
# 단, 온톨로지 그래프 런타임 데이터(graph.py가 로컬 파일로 로드)는 추적·배포
data/*
!data/ontology/
data/ontology/*
!data/ontology/concepts.json
!data/ontology/edges.json
!data/ontology/case_links.json
# 사례 주제 간선 — case_links(인용 간선)와 파일을 나눈다. 순회는 이쪽만 탄다.
!data/ontology/case_topics.json
!data/ontology/bc_links.json
!data/ontology/aliases.json
!data/ontology/topic_concept_map.json
!data/ontology/judgment_trees.json
# 보조 진입(코사인) 개념 벡터 80개 — 6.6MB. 없으면 보조 진입만 비활성되고 나머지는 정상 동작
!data/ontology/concept_embeddings.json

# ── 홀드아웃 gold 라벨 (eval-v2) ──────────────────────────────────
# 검증의 정답지다. 커밋으로 동결해야 "결과를 보고 라벨을 고쳤다"는 의심이 성립하지 않는다.
# 문단 번호 · 짧은 인용구 · 판정 근거만 담긴다.
!data/testdata/
data/testdata/*
!data/testdata/gold_extract/
# 단, 회신문 전문(question·answer_gold)이 통째로 들어간 입력 스냅샷은 제외
data/testdata/gold_extract/input/
data/testdata/gold_extract/step2_input/

# ── 테스트 결과 (JSON) ────────────────────────────────────────────
app/test/**/results/*.json
test-results/
# 질의 임베딩 캐시 6MB — 홀드아웃 질문 72건의 벡터. 스크립트가 없으면 다시 만든다.
app/test/qna_holdout/entry_qvec.json

# ── Claude Code 임시 파일 ─────────────────────────────────────────
*.tmp.*
.claude/settings.local.json
.claude/state/

# ── 스킬 스크래치 워크스페이스 (프로젝트 무관) ───────────────────
_workspace/

# ── 완료된 작업 문서 ──────────────────────────────────────────────
done/

# ── 내부 작업 문서·스크래치 (공개 저장소 제외, 로컬 보존) ─────────
# docs/ 전체는 내부 작업/컨텍스트 문서 (공개 설명은 README로 일원화)
docs/
# dev/ 는 세션 인계용 기계 판독 메모 (docs/와 같은 취급)
dev/
FINAL-REPORT/
app/domain/context_findings.md
app/domain/context_main_text.md
app/domain/context_qna.md
app/domain/trees_plan.md

